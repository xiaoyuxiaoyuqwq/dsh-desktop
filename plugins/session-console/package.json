{
  "name": "dsh-session-console",
  "version": "0.2.0",
  "description": "DSH 会话控制台右侧栏（永久版）：当前对话技能/工具的一览、功能说明与启用开关，以及动态插件活动时间线。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "immediately": true
    }
  },
  "license": "MIT"
}
